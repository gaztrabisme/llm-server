# S015: llama.cpp with MTP + TurboQuant + RotorQuant from Indras-Mirror fork
# Source: Indras-Mirror/llama.cpp-mtp (MTP from PR #22673 + fused CUDA TurboQuant)
# Supports: --spec-type mtp, -ctk tbq4_0/turbo4/planar4_0/iso4_0, Qwen3.5/3.6

# === Build Stage ===
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN git clone --depth 100 https://github.com/Indras-Mirror/llama.cpp-mtp.git .

RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/lib/x86_64-linux-gnu/libcuda.so.1 \
    && ldconfig

# sm_120 for RTX 5080 Blackwell — untested on this fork but standard CUDA intrinsics
RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DGGML_CUDA_FA_ALL_QUANTS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc) \
    && cmake --install build --prefix /opt/llama-cpp

# === Runtime Stage ===
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/llama-cpp /opt/llama-cpp

ENV PATH="/opt/llama-cpp/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llama-cpp/lib:${LD_LIBRARY_PATH}"

VOLUME /models
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["llama-server"]
