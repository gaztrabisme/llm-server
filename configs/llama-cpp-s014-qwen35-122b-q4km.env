# S014: Qwen3.5-122B-A10B Q4_K_M speed test
# Model: 122B total, ~10B active params, MoE (256 experts, top-8 + 1 shared), 48 layers
# Quant: Q4_K_M from unsloth/Qwen3.5-122B-A10B-GGUF (~76.5 GB)
# Hardware: RTX 5080 16GB VRAM, 128GB RAM, 32 cores
# Strategy: --fit on --fit-target 0 (maximize GPU layers), reduced context 32k
# Expected: heavy CPU offload, ~10-20 tok/s estimate (3.3x more active params than 35B)
LLAMA_ARG_MODEL=/models/Qwen3.5-122B-A10B-Q4_K_M.gguf
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
