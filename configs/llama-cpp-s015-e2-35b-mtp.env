# S015 E2: Qwen3.6-35B-A3B MTP UD-Q4_K_XL (MTP n=2, q8_0 KV)
# MTP speculative decode with 2 draft tokens
# MTP adds ~2-3 GB VRAM for draft context, needs fit-target margin
LLAMA_ARG_MODEL=/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_MLOCK=true
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_NO_WARMUP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=131072
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=1536
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_SPEC_TYPE=mtp
LLAMA_ARG_DRAFT_BLOCK_SIZE=3
LLAMA_ARG_CACHE_TYPE_K_DRAFT=q8_0
LLAMA_ARG_CACHE_TYPE_V_DRAFT=q8_0
LLAMA_CHAT_TEMPLATE_KWARGS={"preserve_thinking": true}
