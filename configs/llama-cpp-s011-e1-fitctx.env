# S011 E1: --fit-ctx 65536 vs explicit -c 65536
# Tests whether --fit-ctx N behaves differently from -c N --fit on
# --fit-ctx sets the MINIMUM ctx that --fit can auto-tune (may go higher)
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-Q4_K_M.gguf
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_CTX=65536
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
