# S015 E4: Qwen3.6-27B UD-IQ3_XXS (dense, full GPU, turbo4 KV)
# 12 GB model fits entirely on GPU — no PCIe bottleneck
# turbo4 KV mandatory at 128k (q8_0 would push total to ~16 GB)
LLAMA_ARG_MODEL=/models/Qwen3.6-27B-UD-IQ3_XXS.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_MLOCK=true
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_NO_WARMUP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=131072
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_CACHE_TYPE_K=turbo4
LLAMA_ARG_CACHE_TYPE_V=turbo4
