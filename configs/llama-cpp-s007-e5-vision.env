# S007 E5: Vision Mode — Q4_K_M with mmproj + fit-target 2000
# Requires Docker image built from b8177+ (latest-vision)
# mmproj-BF16.gguf is ~861 MB, fit-target 2000 reserves extra VRAM headroom
# Context reduced to 32k to make room for mmproj in VRAM budget
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-Q4_K_M.gguf
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=2000
LLAMA_ARG_MMPROJ=/models/mmproj-BF16.gguf
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
