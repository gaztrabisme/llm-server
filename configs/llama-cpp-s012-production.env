# S012 Production: UD-Q4_K_XL (March 5, Dynamic 2.0) + fit-target 0
# Unsloth Dynamic 2.0: KLD 0.0137, PPL 6.5918 (vs Q4_K_M KLD 0.0192, PPL 6.6053)
# fit-target 0 squeezes 17/41 overflowing layers (vs 20 at default 1024 margin)
# Result: ~50 tok/s TG across all context lengths, matching Q4_K_M speed
# llama.cpp b8322, Docker image llm-server/llama-cpp:b8322
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
