# vLLM: Qwen3.5-4B AWQ (cyankiwi/Qwen3.5-4B-AWQ-4bit)
# Dense 4B model, natively multimodal (vision built-in, no separate VL variant)
# AWQ 4-bit quantization, 3.85 GiB VRAM — fits comfortably on 16GB GPU
# vLLM serves OpenAI-compatible API at /v1/chat/completions
#
# Start: docker compose --profile vllm up -d
# API:   http://localhost:8090/v1/chat/completions
# Model: qwen3.5-4b (served-model-name)
#
# GPU-exclusive: stop llama-cpp before starting vLLM (they share the GPU)
#   docker compose --profile llama-cpp down
#
# Note: Qwen3.5-9B-AWQ OOMs on 16GB VRAM (~11.2 GiB model + vision encoder
# + Triton GDN kernel autotuner leaves no room for KV cache). 4B works fine.
#
# Sampling params for vision (thinking mode) — send per-request, not server-side:
#   temperature: 1.0
#   top_p: 0.95
#   top_k: 20
#   presence_penalty: 1.5
#   max_tokens: 81920
#
# Thinking mode is ON by default (model generates <think>...</think> blocks)
#
# Server flags:
#   --max-model-len 32768        (enough for vision + thinking)
#   --gpu-memory-utilization 0.90
#   --enforce-eager              (disable CUDA graphs to save VRAM)
#   --limit-mm-per-prompt '{"image": 2}'  (max 2 images per request)
#   --reasoning-parser qwen3     (parse <think> blocks in streaming)
#
# HuggingFace model: cyankiwi/Qwen3.5-4B-AWQ-4bit
# Tested on: vLLM 0.18.0, CUDA 13.1, RTX 5080 16GB
# Image: vllm/vllm-openai:latest
