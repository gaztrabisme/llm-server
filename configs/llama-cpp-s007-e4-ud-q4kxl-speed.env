# S007 E4: Fixed UD-Q4_K_XL — speed benchmark (fit-nobatch config)
# IMPORTANT: Must download FIXED version from unsloth (NOT the old buggy one from S006)
# Download: huggingface-cli download unsloth/Qwen3.5-35B-A3B-GGUF Qwen3.5-35B-A3B-UD-Q4_K_XL.gguf --local-dir models/
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_FIT=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
