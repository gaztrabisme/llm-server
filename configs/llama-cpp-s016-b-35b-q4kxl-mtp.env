# S016 Config B: Qwen3.6-35B-A3B MTP UD-Q4_K_XL (partial offload)
# Mainline b9204+ (MTP merged). ~22 GB model, partial GPU offload.
# MTP adds ~2-3 GB VRAM for draft context — fit-target 1536 reserves margin
# coder543 ubatch PP trick tested here: -ub 512/2048/4096/8192
LLAMA_ARG_MODEL=/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=131072
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=1536
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_N_MAX=2
