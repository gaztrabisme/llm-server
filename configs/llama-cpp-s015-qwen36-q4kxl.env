# S015 E1: Qwen3.6-35B-A3B UD-Q4_K_XL speed test
# Unsloth Dynamic quant (~22.4 GB), same tier as Qwen3.5 production config
# Architecture: Gated DeltaNet + Attention hybrid (replaces SSM from 3.5)
# llama.cpp b8943 — includes attn-rot (Hadamard KV rotation, auto-enabled)
# Expected: ~35-45 tok/s (3.5 was ~50 tok/s, 3.6 ~30% slower per community)
LLAMA_ARG_MODEL=/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
