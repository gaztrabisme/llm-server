# S008 Phase A: UD-Q4_K_XL perplexity at various context sizes
# Used with: docker run --entrypoint llama-perplexity
# Override CTX with bench-matrix.sh --ctx or manually
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_OVERRIDE_TENSOR="exps=CPU"
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
