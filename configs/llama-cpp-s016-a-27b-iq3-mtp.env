# S016 Config A: Qwen3.6-27B MTP UD-IQ3_XXS (dream config)
# Mainline b9204+ (MTP merged). Fits fully on GPU (66/66 layers, 12.45 GB)
# Mainline b9204: 74 tok/s avg, 83 peak, 74% accept (am17an fork: 76/102/90.6%)
LLAMA_ARG_MODEL=/models/Qwen3.6-27B-MTP-UD-IQ3_XXS.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_N_MAX=2
