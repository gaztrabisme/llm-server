# S008 Phase D: AesSedai Q4_K_M perplexity measurement
# Used with: docker run --entrypoint llama-perplexity
LLAMA_ARG_MODEL=/models/aessedai/Q4_K_M/Qwen3.5-35B-A3B-Q4_K_M-00001-of-00002.gguf
LLAMA_ARG_CTX_SIZE=512
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_OVERRIDE_TENSOR="exps=CPU"
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
