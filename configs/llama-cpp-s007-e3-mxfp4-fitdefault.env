# S007 E3: MXFP4 Redemption — MXFP4_MOE with default --fit (no fit-target)
# Baseline comparison: reproduces S006 E7 MXFP4 speed config
LLAMA_ARG_MODEL=/models/Qwen3.5-35B-A3B-UD-MXFP4_MOE.gguf
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_FIT=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_JINJA=true
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
