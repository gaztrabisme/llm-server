# S016 Config C: Qwen3.6-35B-A3B Q8_0 + MTP (heavy offload)
# Mainline b9204+ (MTP merged). ~37 GB model, heavy GPU offload.
# Hypothesis: MTP closes 46% speed gap, making Q8_0 usable (~55+ tok/s)
# Requires MTP GGUF — either from HuggingFace or grafted with graft-mtp.py
LLAMA_ARG_MODEL=/models/Qwen3.6-35B-A3B-MTP-Q8_0.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=1536
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_SPEC_TYPE=draft-mtp
LLAMA_ARG_SPEC_DRAFT_N_MAX=2
