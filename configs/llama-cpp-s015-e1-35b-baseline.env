# S015 E1: Qwen3.6-35B-A3B UD-Q4_K_XL baseline (no MTP, no TurboQuant)
# Production baseline config at 128k context
# Expected: ~35-45 tok/s (3.6 ~30% slower than 3.5 per community)
LLAMA_ARG_MODEL=/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
LLAMA_ARG_PARALLEL=1
LLAMA_ARG_MLOCK=true
LLAMA_ARG_NO_MMAP=true
LLAMA_ARG_NO_WARMUP=true
LLAMA_ARG_FLASH_ATTN=true
LLAMA_ARG_THREADS=20
LLAMA_ARG_JINJA=true
LLAMA_ARG_CTX_SIZE=131072
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
LLAMA_ARG_FIT=true
LLAMA_ARG_FIT_TARGET=0
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
